# ===================================================
# Fieldo サーバー 環境変数テンプレート
# 本番環境では .env にコピーして各値を設定してください
# ===================================================

PORT=3001
NODE_ENV=production

# データベース
DATABASE_URL=postgresql://USER:PASS@HOST:5432/field_work_db

# JWT — 必ず強力なランダム文字列を設定すること
# 生成例: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_AT_LEAST_64_CHARS
JWT_EXPIRES_IN=24h

# CORS — フロントエンドのURLをカンマ区切りで指定
CORS_ORIGIN=https://your-app-domain.com

# SMTP (パスワードリセット・会社登録承認メール)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@fieldo.com

# フロントエンドURL (パスワードリセットメールのリンク生成用)
FRONTEND_URL=https://your-app-domain.com
