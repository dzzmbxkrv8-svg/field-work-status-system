# ===================================================
# Fieldo サーバー 環境変数テンプレート
# 本番環境では .env にコピーして各値を設定してください
# ===================================================

PORT=3001
NODE_ENV=production

# データベース
DATABASE_URL=postgresql://USER:PASS@HOST:5432/field_work_db

# JWT — 必ず強力なランダム文字列を設定すること
# 生成例: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_AT_LEAST_64_CHARS
JWT_EXPIRES_IN=24h

# CORS — フロントエンドのURLをカンマ区切りで指定
CORS_ORIGIN=https://your-app-domain.com

# SMTP (パスワードリセット・会社登録承認メール)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@fieldo.com

# サーバーエラー(5xx)発生時のアラート送信先。未設定ならSMTP_USER宛に送られる。
# 本番(NODE_ENV=production)でのみ有効。5分に1通までのクールダウンあり。
OPERATOR_EMAIL=

# フロントエンドURL (パスワードリセットメールのリンク生成用)
FRONTEND_URL=https://your-app-domain.com

# AI要約機能 (レポートタブ)
# ANTHROPIC_API_KEYがあればAnthropic Claude（有料・高品質）を、
# 無ければGEMINI_API_KEY（無料枠あり）を使う。両方未設定なら機能自体が無効化される。
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# 自動アサイン機能のジオコーディング (住所→座標変換)
# GOOGLE_MAPS_API_KEYがあればGoogle Maps（有料・高精度）を、
# 無ければ国土地理院API（無料・キー不要）を自動で使うため、未設定でも動作する。
GOOGLE_MAPS_API_KEY=

# Web Push通知
# 未設定の場合はPush通知機能全体が無効化される（SSEでの通知は影響を受けない）。
# 生成方法: npx web-push generate-vapid-keys （またはnode -e "console.log(require('web-push').generateVAPIDKeys())"）
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@fieldo.app
